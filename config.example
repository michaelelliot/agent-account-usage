# agent-usage config: copy to ~/.config/agent-usage/config
# Each section is a profile. Optional `name` replaces the profile id in printed output.
# Credentials use one of:
#   claude_config_dir  a Claude Code config dir; the OAuth token Claude Code stored for it is read (read-only)
#   oauth_token        a literal Claude OAuth access token (sk-ant-oat01-...); wins if both are set
#   codex_home         a Codex home dir (~/.codex unless you set CODEX_HOME), where the ChatGPT desktop
#                      app and the codex CLI save your ChatGPT login (read-only)
#   cursor_dir         Cursor's data dir; shows Grok Bot usage for the Cursor account signed in there.
#                      Cursor's saved login is encrypted, so macOS asks once to allow access to the
#                      "Cursor Safe Storage" keychain item (read-only)

[default]
name = "Default"
claude_config_dir = ~/.claude

[personal]
claude_config_dir = ~/.claude-personal

[work]
oauth_token = sk-ant-oat01-...

[chatgpt]
name = "ChatGPT"
codex_home = ~/.codex

[grok]
name = "Grok"
cursor_dir = ~/Library/Application Support/Cursor
